# ---- Resend (Mailversand für Anfragen) -----------------------------------
# Free Tier reicht für ein einzelnes Atelier locker.
# https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxx

# Absenderadresse — muss in Resend verifiziert sein (eigener Domain-DNS-Eintrag)
EMAIL_FROM="Gipfelnaht <hallo@gipfelnaht.ch>"

# Postfach, an das Anfragen ausgeliefert werden (in der Regel == EMAIL_FROM)
EMAIL_PLATFORM="hallo@gipfelnaht.ch"


# ---- Site -----------------------------------------------------------------
# Öffentlicher Base-URL. Wird verwendet für Sitemap, OG-Tags, QR-Code im PDF.
NEXT_PUBLIC_SITE_URL=https://gipfelnaht.ch


# ---- Analytics (optional, cookie-frei) -----------------------------------
# Plausible: einfach die Domain eintragen, das Script wird automatisch geladen.
# Lass die Variable leer, wenn du keine Analytics willst.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
