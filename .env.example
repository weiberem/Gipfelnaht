# Resend API (transactional email)
# https://resend.com — free tier is enough for Phase 1
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxx

# Absenderadresse (muss in Resend verifiziert sein)
EMAIL_FROM="Gipfelnaht <hallo@gipfelnaht.ch>"

# Plattform-Betreiber-Adresse (bekommt CC jeder Anfrage)
EMAIL_PLATFORM="hallo@gipfelnaht.ch"

# Öffentlicher Base-URL (für PDF-QR-Codes, Sitemap, OG-Images)
NEXT_PUBLIC_SITE_URL=https://gipfelnaht.ch

# Analytics — optional, Plausible oder Umami
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Phase-2-Platzhalter (inaktiv in Phase 1, dokumentiert für späteren Rollout)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
